{"uid": "exchange-overview", "title": "Exchange: visão geral", "schemaVersion": 39, "time": {"from": "now-15m", "to": "now"}, "refresh": "5s",
 "panels": [
  {"id": 1, "type": "timeseries", "title": "Ordens aceitas por segundo", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{route=\"POST /orders\",code=\"202\"}[1m]))", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
  {"id": 2, "type": "timeseries", "title": "Latência p95 de POST /orders", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"POST /orders\"}[1m])))", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
  {"id": 3, "type": "timeseries", "title": "Negociações por segundo", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum(rate(engine_trades_emitted_total[1m]))", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
  {"id": 4, "type": "timeseries", "title": "Backlog do outbox", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum(outbox_backlog)", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
  {"id": 5, "type": "timeseries", "title": "Partições por instância do motor", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"refId": "A", "expr": "engine_owned_partitions", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "{{instance}}"}]},
  {"id": 6, "type": "timeseries", "title": "Ordens processadas (live x replay)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (mode) (rate(engine_orders_processed_total[1m]))", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "{{mode}}"}]},
  {"id": 7, "type": "timeseries", "title": "Atraso da cotação p95", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(quote_propagation_seconds_bucket[1m])))", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
  {"id": 8, "type": "timeseries", "title": "Experimento naive: confirmadas/s", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by (mode) (rate(naive_trades_accepted_total[1m]))", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "{{mode}}"}]}
 ]}
